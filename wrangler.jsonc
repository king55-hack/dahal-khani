{
  // Cloudflare Worker for online rooms. Deploy with: npm run server:deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dahal-khani",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDO" },
      { "name": "LOBBY", "class_name": "LobbyDO" },
      { "name": "PRESENCE", "class_name": "PresenceDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDO", "LobbyDO"] },
    { "tag": "v2", "new_sqlite_classes": ["PresenceDO"] }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://king55-hack.github.io,https://dahal-mara-game.rajanrimal.com.np"
  }
}
